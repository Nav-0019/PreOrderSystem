rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions for safe, outlet-scoped role checks ──
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getUserRole() {
      return 'role' in getUserData() ? getUserData().role : 'student';
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isManager() {
      return request.auth != null && (getUserRole() in ['manager', 'staff', 'baker']);
    }

    function isManagerOrAdmin() {
      return isAdmin() || isManager();
    }

    function getManagedOutletId() {
      return 'managedOutletId' in getUserData() ? getUserData().managedOutletId : null;
    }

    function isAssignedManager(outletId) {
      return isAdmin() || (isManager() && getManagedOutletId() == outletId);
    }

    // ── Users Collection ────────────────────────────────────
    match /users/{uid} {
      // Students can read their own profile; admins can read all profiles (SEC-06)
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Create: Users can register their own profile; cannot self-grant admin/manager or isPremium
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('role' in request.resource.data) || request.resource.data.role == 'student' || isAdmin())
                    && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false || isAdmin())
                    && (!('managedOutletId' in request.resource.data) || isAdmin());

      // Update: Users can update basic profile info; privileged fields are locked to Admins
      allow update: if request.auth != null && (
        isAdmin() || (
          request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium', 'managedOutletId'])
        )
      );

      allow delete: if isAdmin();
    }

    // ── Outlets Collection ──────────────────────────────────
    match /outlets/{outletId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      
      // Managers can only update their assigned outlet; admins can update any.
      // SEC-02: Broad client-side queueCount/waitTime modification removed.
      allow update: if isAdmin() || isAssignedManager(outletId);

      // Subcollection menu_items for backward compatibility
      match /menu_items/{itemId} {
        allow read: if true;
        allow write: if isAssignedManager(outletId);
      }
    }

    // ── Canonical Menu Items Collection ─────────────────────
    match /menu_items/{itemId} {
      allow read: if true;

      // Only Admin or the assigned outlet manager can create items
      allow create: if isAdmin() || (
        isManager() &&
        'outletId' in request.resource.data &&
        request.resource.data.outletId == getManagedOutletId()
      );

      // Only Admin or the assigned outlet manager can update/delete items
      allow update: if isAdmin() || (
        isManager() &&
        resource.data.outletId == getManagedOutletId() &&
        (!('outletId' in request.resource.data) || request.resource.data.outletId == resource.data.outletId)
      );

      allow delete: if isAdmin() || (
        isManager() &&
        resource.data.outletId == getManagedOutletId()
      );
    }

    // ── Approval Tickets Collection ─────────────────────────
    match /approval_tickets/{ticketId} {
      // SEC-08: Submitter identity and outlet binding strictly validated
      allow create: if isAdmin() || (
        isManager() &&
        request.resource.data.submittedByUid == request.auth.uid &&
        'outletId' in request.resource.data &&
        request.resource.data.outletId == getManagedOutletId()
      );

      // Submitter, assigned outlet managers, and admins can view approval tickets
      allow read: if request.auth != null && (
        resource.data.submittedByUid == request.auth.uid ||
        isAdmin() ||
        (isManager() && resource.data.outletId == getManagedOutletId())
      );

      // Only Admins can approve or reject tickets
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Orders Collection ───────────────────────────────────
    match /orders/{orderId} {
      // Customer reads their own orders; assigned manager reads their outlet orders; admin reads all
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isAssignedManager(resource.data.outletId)
      );

      // Create: Authenticated customer creates order with valid required fields and pending status
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount > 0
                    && 'outletId' in request.resource.data;

      // Update:
      // 1. Customer can cancel their own order if still pending
      // 2. SEC-03: Assigned manager can only update non-financial status and preparation fields
      allow update: if (
        request.auth != null &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
      ) || (
        isAssignedManager(resource.data.outletId) &&
        request.resource.data.status in ['pending', 'prep', 'ready', 'completed', 'cancelled'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId', 'outletId', 'items', 'totalAmount', 'createdAt',
          'pickupToken', 'paymentMethod', 'paymentStatus'
        ])
      ) || isAdmin();

      // Orders must never be deleted
      allow delete: if false;
    }

    // ── Customer Support Reports ────────────────────────────
    match /support_reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isManagerOrAdmin()
      );
      allow update, delete: if isManagerOrAdmin();
    }

    // ── Time Slots Collection ───────────────────────────────
    match /time_slots/{slotId} {
      allow read: if true;
      // SEC-07: Time-slot writes scoped to assigned outlet for managers
      allow create: if isAdmin() || (
        isManager() &&
        'outletId' in request.resource.data &&
        request.resource.data.outletId == getManagedOutletId()
      );
      allow update, delete: if isAdmin() || (
        isManager() &&
        resource.data.outletId == getManagedOutletId() &&
        (!('outletId' in request.resource.data) || request.resource.data.outletId == resource.data.outletId)
      );
    }

    // ── System Settings Collection ──────────────────────────
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
