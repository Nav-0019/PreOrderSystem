rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role checks without custom claims
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isManagerOrAdmin() {
      return request.auth != null && getUserRole() in ['manager', 'admin', 'staff'];
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    // ── Users ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isManagerOrAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Outlets ─────────────────────────────────────────────
    match /outlets/{outletId} {
      allow read: if true;
      allow write: if request.auth != null && (isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['queueCount', 'waitTime']));

      // Menu items (subcollection of outlets)
      match /menu_items/{itemId} {
        allow read: if true;
        allow write: if isManagerOrAdmin();
      }
    }

    // ── Orders ──────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isManagerOrAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isManagerOrAdmin();
      allow delete: if false; // Never delete orders
    }
  }
}
