rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ───────────────────────────────────────────────
    // Users can only read/write their own profile.
    // Staff and admin can read any user profile.
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.role in ['staff', 'admin']);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Outlets ─────────────────────────────────────────────
    // Anyone (even unauthenticated) can read outlets.
    // Only admins can create/update/delete outlets.
    match /outlets/{outletId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.role == 'admin';

      // Menu items (subcollection of outlets)
      match /menu_items/{itemId} {
        allow read: if true;
        allow write: if request.auth != null &&
          request.auth.token.role in ['staff', 'admin'];
      }
    }

    // ── Orders ──────────────────────────────────────────────
    // Students: read and create their own orders.
    // Staff/admin: read and update all orders.
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         request.auth.token.role in ['staff', 'admin']);

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        request.auth.token.role in ['staff', 'admin'];

      allow delete: if false; // Never delete orders
    }
  }
}
